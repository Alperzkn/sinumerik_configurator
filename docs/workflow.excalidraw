      "versionNonce": 1005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Reads the description, picks the architecture:\n• NCU 1740 / 1750 / 1760 or PPU 1740\n• CNC software variant (export / full scope)\n• Tech packages (S41, S42, S43)\n• Drive family + line module preference\n• HMI panel size + safety level\n\nReturns a small JSON object — short codes only.\nNever invents motor or drive part numbers.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reads the description, picks the architecture:\n• NCU 1740 / 1750 / 1760 or PPU 1740\n• CNC software variant (export / full scope)\n• Tech packages (S41, S42, S43)\n• Drive family + line module preference\n• HMI panel size + safety level\n\nReturns a small JSON object — short codes only.\nNever invents motor or drive part numbers.",
      "lineHeight": 1.25
    },
